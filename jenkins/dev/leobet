pipeline {
    agent any
    tools {nodejs "nodejs"}
    environment{
        node_modules_exists = fileExists 'node_modules'
        site = 'leobet'
        project_name = 'leobet'
        env = 'dev'
        ansible_path = '/var/jenkins_home/ansible/frontend/'
        harbor_registry = '13.213.82.69/desktop/nova88v2-dev'
    }
     stages {
        stage('多線程處理') {
            // 多線程處理兩個 build
            parallel{
                stage("Start"){
                    stages {
                        stage('Install dependencies') {
                            when {
                                anyOf {
                                    changeset "package.json"
                                    expression { node_modules_exists == 'false' }
                                }
                            }
                            steps {
                                sh 'npm i -g node-sass'
                                sh 'npm i --force'
                            }
                        }
                        stage('Build') {
                            steps {
                                sh 'npx gulp minify --gulpfile=apps/${project_name}/gulpfile.js'
                                sh '(git rev-parse --short=7 HEAD & git rev-parse --abbrev-ref HEAD) > apps/${project_name}/static/rnt.txt'
                                sh 'npx nx clear-cache'
                                sh 'npx nx autoBuild ${project_name} --skip-nx-cache'
                            }
                        }
                        stage('Zip'){
                            steps {
                                dir("apps/${project_name}/public"){
                                script {
                                    env.commitHash = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                                }
                                sh 'zip -r desktop-${site}-${commitHash} *'
                                sh 'curl -v -u admin:123456 --upload-file desktop-${site}-${commitHash}.zip http://172.31.28.169:8081/repository/artifacts/Frontend/desktop/${site}/${env}/desktop-${site}-${commitHash}.zip'
                                sh 'echo desktop-${site}-${commitHash}'
                                }
                            }
                        }
                        stage('Deploy') {
                            steps {
                                sh 'ansible-playbook -i ${ansible_path}host.yml ${ansible_path}deploy.yml --extra-vars "commitId=${commitHash} site=${site} platform=desktop host=desktop-${site} env=${env}"'
                            }
                        }
                    }
                }
            }
        }
    }
}