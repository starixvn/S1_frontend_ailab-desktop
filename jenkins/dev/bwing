pipeline {
    agent any
    tools {nodejs "nodejs"}
    environment{
        node_modules_exists = fileExists 'node_modules'
        site = 'bwing'
        project_name = 'bwing'
        env = 'dev'
        ansible_path = '/var/jenkins_home/ansible/frontend/'
        harbor_registry = '13.213.82.69/desktop/bwing-dev'
    }
     stages {
        stage('多線程處理') {
            // 多線程處理兩個 build
            parallel{
                stage("Start"){
                    stages {
                        stage('Set Environment') {
                            steps {
                                script {
                                    env.env = 'development'
                                    env.NODE_ENV = 'development'
                                    env.CUSTOM_ENV = 'development'
                                    env.REACT_APP_ENV = 'development'
                                }
                            }
                        }
                        stage('Install dependencies') {
                            when {
                                anyOf {
                                    changeset "package.json"
                                    expression { node_modules_exists == 'false' }
                                }
                            }
                            steps {
                                sh 'rm -rf node_modules'
                                sh 'rm package-lock.json'
                                sh 'npm cache clean --force'
                                sh 'npm i -g node-sass'
                                sh 'npm i --force'
                            }
                        }
                        stage('Build') {
                            steps {
                                sh 'npx gulp minify --gulpfile=apps/${project_name}/gulpfile.js'
                                sh '(git rev-parse --short=7 HEAD & git rev-parse --abbrev-ref HEAD) > apps/${project_name}/static/rnt.txt'
                                sh 'npx nx clear-cache'
                                sh 'npx nx autoBuild ${project_name} --skip-nx-cache'
                            }
                        }
                        stage('Zip'){
                            steps {
                                dir("apps/${project_name}/public"){
                                script {
                                    env.commitHash = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                                    currentBuild.displayName = env.commitHash
                                }
                                sh 'zip -r desktop-${site}-${commitHash} *'
                                sh 'curl -v -u admin:123456 --upload-file desktop-${site}-${commitHash}.zip http://172.31.28.169:8081/repository/artifacts/Frontend/desktop/${site}/${env}/desktop-${site}-${commitHash}.zip'
                                sh 'echo desktop-${site}-${commitHash}'
                                }
                            }
                        }
                        stage('Deploy') {
                            steps {
                                sh 'ansible-playbook -i ${ansible_path}host.yml ${ansible_path}deploy.yml --extra-vars "commitId=${commitHash} site=${site} platform=desktop host=desktop-${site} env=${env}"'
                            }
                        }
                    }
                }
                // stage('DockerBuild') {
                //    agent { node { label 'Build' } }
                //        steps{
                //            script {
                //                env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                //            }
                //            sh 'sudo docker build --build-arg project_name=${project_name} -t ${harbor_registry}:${version} . '
                //            sh 'sudo docker login 13.213.82.69 -u jenkins -p 06ftJ0Ds'
                //            sh 'sudo docker push ${harbor_registry}:${version}'
                //            sh 'sudo docker rmi ${harbor_registry}:${version}'
                //        }
                //
                // }
            }
        }
    }
}