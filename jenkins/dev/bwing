pipeline {
    agent any
    tools {nodejs "nodejs"}
    environment{
        node_modules_exists = fileExists 'node_modules'
        auto_deploy = fileExists 'deploy.yml'
        site = 'bwing'
        project_name = 'bwing'
        env = 'dev'
        path = '/var/jenkins_home/ansible/frontend/'
    }
    stages {
        stage('Install dependencies') {
            when {
                anyOf {
                    changeset "package.json"
                    expression { node_modules_exists == 'false' }
                }
            }
            steps {
                sh 'npm i -g node-sass'
                sh 'npm install'
            }
        }
        stage('Build') {
            steps {
                sh 'npx gulp minify --gulpfile=apps/${project_name}/gulpfile.js'
                sh '(git rev-parse --short=7 HEAD & git rev-parse --abbrev-ref HEAD) > apps/${project_name}/static/rnt.txt'
                sh 'npx nx autoBuild ${project_name} --skip-nx-cache'
            }
        }
        stage('Zip'){
            steps {
                dir("apps/${project_name}/public"){
                    script {
                        env.commitHash = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    }
                    sh 'zip -r desktop-${site}-${commitHash} *'
                    sh 'curl -v -u admin:123456 --upload-file desktop-${site}-${commitHash}.zip http://172.31.28.233:8081/repository/artifacts/Frontend/desktop/${site}/${env}/desktop-${site}-${commitHash}.zip'
                    sh 'echo desktop-${site}-${commitHash}'
                }
            }
        }
        stage('Deploy') {
            when {
                expression { auto_deploy == 'true' }
            }
            steps {
                sh 'ansible-playbook -i ${path}host.yml deploy.yml --extra-vars "commitId=${commitHash} site=${site} platform=desktop host=desktop-${site} env=${env}"'
            }
        }
    }
}