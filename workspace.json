        "test": {
          "builder": "@nrwl/jest:jest",
          "options": {
            "jestConfig": "libs/service/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    },
    "common": {
      "root": "libs/common",
      "sourceRoot": "libs/common/src",
      "projectType": "library",
