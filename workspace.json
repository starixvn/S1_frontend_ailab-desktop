						"color": true,
						"profile": false
					},
					"configurations": {
						"production": {}
					}
				},
				"build": {
					"builder": "@nrwl/workspace:run-commands",
					"options": {
						"commands": [
							"gulp minify --gulpfile=apps/nova88/gulpfile.js",
							"nx autoBuild nova88 --skip-nx-cache"
						],
						"parallel": false
					},
					"configurations": {
						"production": {}
					}
				},
				"autoServe": {
					"builder": "@nrwl/gatsby:server",
					"options": {
						"buildTarget": "nova88:build",
						"port": 4201,
						"open": true
					},
					"configurations": {
						"production": {
							"buildTarget": "nova88:build:production"
						}
					}
				},
