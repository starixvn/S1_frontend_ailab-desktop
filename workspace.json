            "passWithNoTests": true
          }
        }
      }
    },
    "nova88": {
      "root": "apps/nova88",
      "sourceRoot": "apps/nova88/src",
      "projectType": "application",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@nrwl/gatsby:build",
          "options": {
            "outputPath": "apps/nova88/public",
            "uglify": true,
            "color": true,
            "profile": false
          },
          "configurations": {
            "production": {}
          }
        },
        "serve": {
          "builder": "@nrwl/gatsby:server",
          "options": {
            "buildTarget": "nova88:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "nova88:build:production"
            }
          }
        },
        "lint": {
          "builder": "@nrwl/linter:eslint",
          "options": {}
