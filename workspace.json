      }
    },
    "nova88-e2e": {
      "root": "apps/nova88-e2e",
      "sourceRoot": "apps/nova88-e2e/src",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@nrwl/cypress:cypress",
          "options": {
            "cypressConfig": "apps/nova88-e2e/cypress.json",
            "tsConfig": "apps/nova88-e2e/tsconfig.e2e.json",
            "devServerTarget": "nova88:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "nova88:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@nrwl/linter:eslint",
          "options": {
            "lintFilePatterns": ["apps/nova88-e2e/**/*.{js,ts}"]
          }
        }
      }
